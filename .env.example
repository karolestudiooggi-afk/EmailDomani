# URL pública (links de tracking: pixel/clique)
APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP ÚNICO DA AGÊNCIA (conta SendPulse com os domínios dos clientes autenticados)
# Sem SMTP_HOST = modo mock (não envia, só loga).
SMTP_HOST=smtp.sendpulse.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Chave de criptografia (legado; gere com: openssl rand -hex 32)
ENCRYPTION_KEY=

# Fila / limites
DISPATCH_BATCH_SIZE=40
DAILY_SEND_LIMIT=12000

# Protege o endpoint do cron
CRON_SECRET=
